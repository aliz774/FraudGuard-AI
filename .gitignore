# ─────────────────────────────────────────────────────────────────
# .gitignore — Prevent huge datasets and temporary files from git
# ─────────────────────────────────────────────────────────────────

# Huge dataset files (GitHub strictly rejects files > 100MB)
*.csv
backend/Fraud.csv
Fraud.csv

# Python bytecode & cache
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/

# Temporary files
*.tmp
*.log
.DS_Store
Thumbs.db
